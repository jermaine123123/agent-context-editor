{
  "name": "pi-context-editor",
  "version": "0.4.0-alpha.1",
  "description": "Cross-agent context editor for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "desktop",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build:core": "node scripts/build-core.mjs",
    "build": "node ../../scripts/build-pi.mjs",
    "prepack": "npm run build:core && npm run build",
    "verify": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.84.2 <0.85.0-0",
    "@earendil-works/pi-ai": ">=0.84.2 <0.85.0-0",
    "@earendil-works/pi-coding-agent": ">=0.84.2 <0.85.0-0",
    "@earendil-works/pi-tui": ">=0.84.2 <0.85.0-0"
  }
}
